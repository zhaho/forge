PORT=3000
# Change this to a long random string in production
SESSION_SECRET=change-me
DATA_DIR=./data
MAX_CONCURRENT_DEPLOYMENTS=3

# Proxmox
PM_API_URL=https://proxmox.example.duckdns.org/
PM_API_TOKEN_ID=root@pam
PM_API_TOKEN_SECRET=change-me
PROXMOX_TARGET_NODE=proxmox
PROXMOX_NETWORK_BRIDGE=vmbr0
PROXMOX_DATASTORE=local-lvm
PROXMOX_TEMPLATE_ID=9200
# Direct SSH access to the Proxmox host itself (distinct from the SSH section
# below, which targets deployed VMs) - required for the Images feature.
PROXMOX_SSH_HOST=
PROXMOX_SSH_USER=root

# phpIPAM
IPAM_ENABLE=true
IPAM_URL=http://10.4.5.66
IPAM_APP_ID=terraform
IPAM_USERNAME=admin
IPAM_PASSWORD=change-me
IPAM_SUBNET_ID=7

# reach the Proxmox host for the Images feature)
HOST_USER=zhaho
SSH_PRIVATE_KEY_PATH=/home/forge/.ssh/id_rsa

# Images (cloud-init defaults baked into images Forge builds)
IMAGE_CI_USER=zhaho
IMAGE_CI_PASSWORD=
IMAGE_CI_UPGRADE=1
IMAGE_CI_IPCONFIG=ip=dhcp
IMAGE_VM_MEMORY=2048
IMAGE_VM_DISK_SIZE=20G
IMAGE_VMID_RANGE_START=9000
