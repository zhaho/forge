<%- include('partials/header') %>
  <nav>
    <ul>
      <li><%- include('partials/brand') %></li>
    </ul>
    <ul>
      <li><a href="/roles">Roles</a></li>
      <li>
        <div class="user-menu">
          <span class="user-avatar">
            <%= username.charAt(0).toUpperCase() %>
          </span>
          <span class="user-name">
            <%= username %>
          </span>
          <form method="POST" action="/logout" class="logout-form">
            <button type="submit" class="logout-btn" title="Logout" aria-label="Logout">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
            </button>
          </form>
        </div>
      </li>
    </ul>
  </nav>
  <h1>Dashboard</h1>
  <p><a href="/deployments/new" role="button">New deployment</a></p>

  <% if (deployments.length===0) { %>
    <p>No deployments yet.</p>
    <% } else { %>
      <% var active=deployments.filter(function (d) { return d.status !=='destroyed' ; }); %>
        <% var destroyed=deployments.filter(function (d) { return d.status==='destroyed' ; }); %>

          <% if (active.length===0) { %>
            <p>No active deployments.</p>
            <% } else { %>
              <table class="deployments-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Nodes</th>
                    <th>Created</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% active.forEach(function (deployment) { %>
                    <tr>
                      <td><a href="/deployments/<%= deployment.id %>">
                          <%= deployment.name %>
                        </a></td>
                      <td>
                        <%= deployment.role_label %>
                      </td>
                      <td><span class="status status-<%= deployment.status %>">
                          <%= deployment.status %>
                        </span></td>
                      <td>
                        <% if (deployment.node_ips) { %>
                          <%= deployment.node_ips.split(',').join(', ') %>
                          <% } else { %>
                            <em><%= deployment.node_count %> pending</em>
                            <% } %>
                      </td>
                      <td>
                        <%= deployment.created_at %>
                      </td>
                      <td class="actions-cell">
                        <% if (deployment.status===' failed' ) { %>
                            <form method="POST" action="/deployments/<%= deployment.id %>/retry">
                              <button type="submit">Retry</button>
                            </form>
                            <% } %>
                              <% if (['success', 'failed' ].includes(deployment.status)) { %>
                                <form method="POST" action="/deployments/<%= deployment.id %>/destroy"
                                  onsubmit="return confirm('Destroy all nodes in \'<%= deployment.name %>\'? This cannot be undone.');">
                                  <button type="submit" class="contrast">Destroy</button>
                                </form>
                                <% } %>
                      </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
              <% } %>

                <% if (destroyed.length> 0) { %>
                  <details>
                    <summary>Destroyed (<%= destroyed.length %>)</summary>
                    <table class="deployments-table">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Role</th>
                          <th>Status</th>
                          <th>Created</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% destroyed.forEach(function (deployment) { %>
                          <tr class="is-destroyed">
                            <td><a href="/deployments/<%= deployment.id %>">
                                <%= deployment.name %>
                              </a></td>
                            <td>
                              <%= deployment.role_label %>
                            </td>
                            <td><span class="status status-<%= deployment.status %>">
                                <%= deployment.status %>
                              </span></td>
                            <td>
                              <%= deployment.created_at %>
                            </td>
                          </tr>
                          <% }) %>
                      </tbody>
                    </table>
                  </details>
                  <% } %>
                    <% } %>
                      <%- include('partials/footer') %>