<%- include('partials/header') %>
  <%- include('partials/nav') %>

    <h1 class="text-2xl font-bold mb-4">Dashboard</h1>
    <p class="mb-4"><a href="/deployments/new" class="btn btn-primary btn-sm rounded-sm">New deployment</a></p>

    <% if (deployments.length===0) { %>
      <p>No deployments yet.</p>
      <% } else { %>
        <% var active=deployments.filter(function (d) { return d.status !=='destroyed' ; }); %>
          <% var destroyed=deployments.filter(function (d) { return d.status==='destroyed' ; }); %>

            <% if (active.length===0) { %>
              <p>No active deployments.</p>
              <% } else { %>
                <div class="overflow-x-auto mb-6">
                  <table class="table">
                    <thead>
                      <tr>
                        <th>Name</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Nodes</th>
                        <th>Created</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% active.forEach(function (deployment) { %>
                        <tr>
                          <td><a class="link link-hover" href="/deployments/<%= deployment.id %>">
                              <%= deployment.name %>
                            </a></td>
                          <td>
                            <%= deployment.role_label %>
                          </td>
                          <td><%- include('partials/status-badge', { status: deployment.status }) %></td>
                          <td>
                            <% if (deployment.node_ips) { %>
                              <%= deployment.node_ips.split(',').join(', ') %>
                          <% } else { %>
                            <em><%= deployment.node_count %> pending</em>
                            <% } %>
                      </td>
                      <td>
                        <%= deployment.created_at %>
                      </td>
                      <td class="flex flex-wrap gap-2 whitespace-nowrap">
                        <% if (deployment.status===' failed' ) { %>
                                <form method="POST" action="/deployments/<%= deployment.id %>/retry"
                                  data-loading-text="Retrying...">
                                  <button type="submit" class="btn btn-sm rounded-sm">Retry</button>
                                </form>
                                <% } %>
                                  <% if (['success', 'failed' ].includes(deployment.status)) { %>
                                    <form method="POST" action="/deployments/<%= deployment.id %>/destroy"
                                      data-loading-text="Destroying..."
                                      onsubmit="return confirm('Destroy all nodes in \'<%= deployment.name %>\'? This cannot be undone.');">
                                      <button type="submit" class="btn btn-error btn-sm rounded-sm">Destroy</button>
                                    </form>
                                    <% } %>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                  </table>
                </div>
                <% } %>

                  <% if (destroyed.length> 0) { %>
                    <details class="mb-6">
                      <summary class="cursor-pointer font-semibold mb-2">Destroyed (<%= destroyed.length %>)</summary>
                      <div class="overflow-x-auto">
                        <table class="table">
                          <thead>
                            <tr>
                              <th>Name</th>
                              <th>Role</th>
                              <th>Status</th>
                              <th>Created</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% destroyed.forEach(function (deployment) { %>
                              <tr class="opacity-60">
                                <td><a class="link link-hover" href="/deployments/<%= deployment.id %>">
                                    <%= deployment.name %>
                                  </a></td>
                                <td>
                                  <%= deployment.role_label %>
                                </td>
                                <td><%- include('partials/status-badge', { status: deployment.status }) %></td>
                                <td>
                                  <%= deployment.created_at %>
                                </td>
                              </tr>
                              <% }) %>
                          </tbody>
                        </table>
                      </div>
                    </details>
                    <% } %>
                      <% } %>
                        <%- include('partials/footer') %>