<div class="navbar bg-base-200 rounded-box mb-6 px-4 shadow-sm">
  <div class="flex-1">
    <%- include('./brand') %>
  </div>
  <div class="flex-none flex items-center gap-2">
    <a href="/" class="btn btn-sm btn-outline rounded-none">Dashboard</a>
    <a href="/roles" class="btn btn-sm btn-outline rounded-none">Roles</a>
    <% if (typeof username !=='undefined' ) { %>
      <div class="flex items-center gap-2 rounded-full bg-base-300 py-1 pl-1 pr-3">
        <div class="avatar placeholder">
          <div class="w-7 rounded-full bg-gradient-to-br from-[#F7941D] to-[#ED1C24] text-white">
            <span class="text-xs font-bold">
              <%= username.charAt(0).toUpperCase() %>
            </span>
          </div>
        </div>
        <span class="text-sm">
          <%= username %>
        </span>
        <form method="POST" action="/logout" class="inline">
          <button type="submit" class="btn btn-ghost btn-circle btn-xs" title="Logout" aria-label="Logout">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <polyline points="16 17 21 12 16 7" />
              <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
          </button>
        </form>
      </div>
      <% } %>
  </div>
</div>