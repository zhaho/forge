<%- include('../partials/header') %>
  <%- include('../partials/nav') %>

    <h1 class="text-2xl font-bold mb-4">Edit role: <%= role.label %>
    </h1>
    <% if (error) { %>
      <p class="text-error text-sm mb-4">
        <%= error %>
      </p>
      <% } %>
        <form method="POST" action="/roles/<%= role.id %>" class="flex flex-col gap-3 max-w-xl">
          <label class="form-control w-full">
            <span class="label-text mb-1">Label</span>
            <input type="text" id="label" name="label" value="<%= form.label %>" required autofocus
              class="input input-bordered rounded-sm w-full">
            <span class="label-text-alt mt-1 text-base-content/60">Key: <code><%= role.key %></code> (fixed)</span>
          </label>

          <label class="form-control w-full">
            <span class="label-text mb-1">Default image</span>
            <select id="defaultImageId" name="defaultImageId" class="select select-bordered rounded-sm w-full">
              <option value="">Use global template (PROXMOX_TEMPLATE_ID)</option>
              <% images.forEach(function (image) { %>
                <option value="<%= image.id %>" <%=String(form.defaultImageId)===String(image.id) ? 'selected' : '' %>>
                  <%= image.name %> (VMID <%= image.vm_id %>)
                </option>
                <% }) %>
            </select>
            <span class="label-text-alt mt-1 text-base-content/60">Template new deployments of this role clone from,
              unless overridden per-deployment.</span>
          </label>

          <fieldset class="border border-base-300 rounded-sm p-3">
            <legend class="px-2 font-semibold">Components</legend>
            <ul class="divide-y divide-base-300 border border-base-300">
              <% components.forEach(function (component) { %>
                <li>
                  <label class="flex items-center gap-3 w-full p-3 cursor-pointer hover:bg-base-200">
                    <input type="checkbox" name="componentIds" value="<%= component.id %>"
                      <%=form.componentIds.includes(component.id) ? 'checked' : '' %> class="checkbox checkbox-sm
                    rounded-sm">
                    <span class="flex flex-col gap-0.5">
                      <span class="font-semibold">
                        <%= component.label %>
                      </span>
                      <% if (component.description) { %>
                        <span class="text-sm text-base-content/60">
                          <%= component.description %>
                        </span>
                        <% } %>
                    </span>
                  </label>
                </li>
                <% }) %>
            </ul>
          </fieldset>

          <button type="submit" class="btn btn-primary btn-sm rounded-sm w-fit">Save changes</button>
        </form>
        <%- include('../partials/footer') %>