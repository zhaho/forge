<%- include('../partials/header') %>
  <nav>
    <ul>
      <li><%- include('../partials/brand') %></li>
    </ul>
    <ul>
      <li><a href="/roles">&larr; Roles</a></li>
    </ul>
  </nav>
  <h1>Edit role: <%= role.label %>
  </h1>
  <% if (error) { %>
    <p style="color: var(--pico-del-color);">
      <%= error %>
    </p>
    <% } %>
      <form method="POST" action="/roles/<%= role.id %>" class="form-compact">
        <label for="label">Label
          <input type="text" id="label" name="label" value="<%= form.label %>" required autofocus>
        </label>
        <small>Key: <code><%= role.key %></code> (fixed)</small>

        <fieldset>
          <legend>Components</legend>
          <% components.forEach(function (component) { %>
            <label>
              <input type="checkbox" name="componentIds" value="<%= component.id %>"
                <%=form.componentIds.includes(component.id) ? 'checked' : '' %>>
              <%= component.label %>
                <% if (component.description) { %><small> &mdash; <%= component.description %></small>
                  <% } %>
            </label>
            <% }) %>
        </fieldset>

        <button type="submit" class="btn-sm">Save changes</button>
      </form>
      <%- include('../partials/footer') %>