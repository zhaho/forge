<%- include('../partials/header') %>
  <%- include('../partials/nav') %>

    <h1 class="text-2xl font-bold mb-4">Roles</h1>
    <p class="mb-4"><a href="/roles/new" class="btn btn-primary btn-sm rounded-none">New role</a></p>

    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Label</th>
            <th>Key</th>
            <th>Components</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% roles.forEach(function (role) { %>
            <tr>
              <td>
                <%= role.label %>
              </td>
              <td><code><%= role.key %></code></td>
              <td>
                <% if (role.isComponentBased) { %>
                  <% if (role.components.length===0) { %>
                    <em>none selected</em>
                    <% } else { %>
                      <%= role.components.map(function (c) { return c.label; }).join(', ') %>
              <% } %>
            <% } else { %>
              <em>dedicated playbook (<%= role.playbook_path %>)</em>
            <% } %>
          </td>
          <td><a class="link link-hover" href="/roles/<%= role.id %>/edit">Edit</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
</main>
<footer class="footer footer-center p-4 border-t border-base-300 text-base-content">
  <p>&copy; Kenneth Ros <%= new Date().getFullYear() %></p>
</footer>
<script src="/public/js/action-forms.js"></script>
</body>

</html>