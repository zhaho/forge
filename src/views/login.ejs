<%- include('partials/header') %>
  <article style="max-width: 30rem; margin: 4rem auto;">
    <img src="/public/img/logo-mark.svg" alt="Forge" class="brand-logo-big">
    <p class="brand-text brand-text-big">FORGE</p>
    <hgroup>
      <p>Sign in</p>
    </hgroup>
    <% if (error) { %>
      <p style="color: var(--pico-del-color);">
        <%= error %>
      </p>
      <% } %>
        <form method="POST" action="/login" class="form-compact">
          <label for="username">Username
            <input type="text" id="username" name="username" required autofocus>
          </label>
          <label for="password">Password
            <input type="password" id="password" name="password" required>
          </label>
          <button type="submit" class="btn-sm">Log in</button>
        </form>
  </article>
  <%- include('partials/footer') %>