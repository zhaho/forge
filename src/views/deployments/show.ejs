<%- include('../partials/header') %>
  <%- include('../partials/nav') %>

    <div class="card bg-base-200 shadow-sm mb-6">
      <div class="card-body flex-row flex-wrap items-center justify-between gap-4 py-4">
        <div>
          <h1 class="text-2xl font-bold">
            <%= deployment.name %> <span class="text-base-content/60 font-normal text-base">(<%= role.label %>)</span>
          </h1>
          <div class="mt-1">
            <%- include('../partials/status-badge', { status: deployment.status, id: 'deployment-status' }) %>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-base-content/60">
            <% if (deployment.started_at) { %>
              <span class="inline-flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  class="shrink-0">
                  <circle cx="12" cy="12" r="9" />
                  <polyline points="12 7 12 12 15.5 14" />
                </svg>
                Started <%= deployment.started_at %>
              </span>
              <% } %>
                <% if (deployment.finished_at) { %>
                  <span class="inline-flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      class="shrink-0">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    Finished <%= deployment.finished_at %>
                  </span>
                  <% } %>
                    <% if (deployment.duration) { %>
                      <span class="inline-flex items-center gap-1.5 font-medium text-base-content/80">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none"
                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                          class="shrink-0">
                          <circle cx="12" cy="13" r="7" />
                          <path d="M12 9v4l2.5 1.5M9 3h6M12 3v3" />
                        </svg>
                        Took <%= deployment.duration %>
                      </span>
                      <% } %>
                        <% if (['running', 'queued' ].includes(deployment.status)) { %>
                          <span id="elapsed-counter" class="inline-flex items-center gap-1.5 font-medium text-info">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14"
                              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                              stroke-linejoin="round" class="shrink-0">
                              <circle cx="12" cy="13" r="7" />
                              <path d="M12 9v4l2.5 1.5M9 3h6M12 3v3" />
                            </svg>
                            <span id="elapsed-text">Queued...</span>
                          </span>
                          <% } %>
          </div>
        </div>
        <div class="flex gap-2">
          <% if (deployment.status==='failed' ) { %>
            <form method="POST" action="/deployments/<%= deployment.id %>/retry" data-loading-text="Retrying...">
              <button type="submit" class="btn btn-sm rounded-sm">Retry</button>
            </form>
            <% } %>
              <% if (['success', 'failed' ].includes(deployment.status)) { %>
                <form method="POST" action="/deployments/<%= deployment.id %>/destroy" data-loading-text="Destroying..."
                  onsubmit="return confirm('Destroy all nodes in \'<%= deployment.name %>\'? This cannot be undone.');">
                  <button type="submit" class="btn btn-error btn-sm rounded-sm">Destroy</button>
                </form>
                <% } %>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
      <div class="card bg-base-200 shadow-sm lg:col-span-1">
        <div class="card-body">
          <h2 class="card-title text-lg">Nodes</h2>
          <ul class="flex flex-col divide-y divide-base-300">
            <% nodes.forEach(function (node) { %>
              <li class="py-2 flex items-center justify-between gap-2">
                <span>
                  <span class="font-semibold">
                    <%= node.name %>
                  </span>
                  <% if (node.sub_role) { %>
                    <span class="badge badge-ghost rounded-sm badge-sm ml-1">
                      <%= node.sub_role %>
                    </span>
                    <% } %>
                      <span class="block text-sm text-base-content/60">
                        <%= node.ip || 'pending IP' %>
                      </span>
                </span>
                <%- include('../partials/status-badge', { status: node.status }) %>
              </li>
              <% }) %>
          </ul>
        </div>
      </div>

      <div class="card bg-base-200 shadow-sm lg:col-span-2">
        <div class="card-body">
          <h2 class="card-title text-lg mb-2">Steps</h2>
          <% var totalSteps=steps.length; var doneSteps=steps.filter(function (s) { return s.status==='success' ;
            }).length; var stepsPct=totalSteps ? Math.round((doneSteps / totalSteps) * 100) : 0; %>
            <div id="steps-progress-track"
              class="w-full h-2 rounded-sm bg-base-300 overflow-hidden mb-3 <%= ['running', 'queued' ].includes(deployment.status) ? '' : 'hidden' %>">
              <div id="steps-progress-bar"
                class="h-full bg-info transition-all duration-500 ease-out <%= deployment.status==='running' ? 'steps-progress-active' : '' %>"
                style="width: <%= stepsPct %>%"></div>
            </div>
            <ul class="steps steps-vertical">
              <% var stepDotClass={ success: 'step-success' , failed: 'step-error' , interrupted: 'step-error' ,
                running: 'step-info' , queued: 'step-info' }; %>
                <% var stepAnimClass={ running: 'step-active-pulse' }; %>
                  <% steps.forEach(function (step) { %>
                    <li class="step <%= stepDotClass[step.status] || '' %> <%= stepAnimClass[step.status] || '' %>"
                      data-step="<%= step.seq %>">
                      <span class="flex items-center gap-2 text-left">
                        <span class="font-medium w-48 shrink-0">
                          <%= step.name.replace(/_/g, ' ' ) %>
                        </span>
                        <%- include('../partials/status-badge', { status: step.status }) %>
                          <% if (step.status==='running' ) { %>
                            <span class="loading loading-spinner loading-xs text-info"></span>
                            <% } %>
                      </span>
                    </li>
                    <% }) %>
            </ul>
        </div>
      </div>
    </div>

    <div class="card bg-base-200 shadow-sm mb-6">
      <div class="card-body">
        <h2 class="card-title text-lg">Components</h2>
        <% if (role.playbook_path) { %>
          <p><em>This role uses a dedicated playbook (<%= role.playbook_path %>), not the component system.</em></p>
          <% } else { %>
            <% var canManage=['success', 'failed' ].includes(deployment.status); %>

              <% if (installedComponents.length===0) { %>
                <p class="mb-2"><em>Nothing installed yet.</em></p>
                <% } else { %>
                  <div class="overflow-x-auto">
                    <table class="table">
                      <thead>
                        <tr>
                          <th>Component</th>
                          <th>Status</th>
                          <th>Description</th>
                          <th></th>
                        </tr>
                      </thead>
                      <tbody>
                        <% installedComponents.forEach(function (component) { %>
                          <tr>
                            <td>
                              <%= component.label %>
                            </td>
                            <td><%- include('../partials/status-badge', { status: component.installStatus }) %></td>
                            <td><small>
                                <%= component.description || '' %>
                              </small></td>
                            <td class="flex flex-wrap gap-2 whitespace-nowrap">
                              <% if (canManage) { %>
                                <form method="POST"
                                  action="/deployments/<%= deployment.id %>/reinstall/<%= component.id %>"
                                  data-loading-text="Reinstalling...">
                                  <button type="submit" class="btn btn-outline btn-sm rounded-sm">Reinstall</button>
                                </form>
                                <form method="POST"
                                  action="/deployments/<%= deployment.id %>/components/<%= component.id %>/uninstall"
                                  data-loading-text="Removing...">
                                  <button type="submit"
                                    class="btn btn-outline btn-error btn-sm rounded-sm">Remove</button>
                                </form>
                                <% } %>
                            </td>
                          </tr>
                          <% }) %>
                      </tbody>
                    </table>
                  </div>
                  <% } %>

                    <% if (canManage) { %>
                      <form method="POST" action="/deployments/<%= deployment.id %>/reinstall" class="mt-3"
                        data-loading-text="Reinstalling...">
                        <button type="submit" class="btn btn-sm rounded-sm">Reinstall everything</button>
                      </form>
                      <% } %>

                        <% if (availableComponents.length> 0) { %>
                          <div class="divider">Add a component</div>
                          <input type="search" id="component-search" placeholder="Search packages..."
                            class="input input-bordered input-sm rounded-sm w-full max-w-sm mb-2">
                          <ul id="available-components-list" class="divide-y divide-base-300 border border-base-300">
                            <% availableComponents.forEach(function (component) { %>
                              <li class="component-option flex items-center justify-between gap-3 p-3"
                                data-label="<%= component.label.toLowerCase() %>">
                                <span class="flex flex-col gap-0.5">
                                  <span class="font-semibold">
                                    <%= component.label %>
                                  </span>
                                  <% if (component.description) { %>
                                    <span class="text-sm text-base-content/60">
                                      <%= component.description %>
                                    </span>
                                    <% } %>
                                </span>
                                <% if (canManage) { %>
                                  <form method="POST"
                                    action="/deployments/<%= deployment.id %>/components/<%= component.id %>/install"
                                    data-loading-text="Installing...">
                                    <button type="submit" class="btn btn-primary btn-xs rounded-sm">Install</button>
                                  </form>
                                  <% } %>
                              </li>
                              <% }) %>
                          </ul>
                          <% } %>
                            <% } %>
      </div>
    </div>

    <div class="card bg-base-200 shadow-sm mb-6">
      <div class="card-body">
        <h2 class="card-title text-lg">Log</h2>
        <pre id="log"
          class="max-h-[400px] overflow-y-auto bg-neutral text-neutral-content p-4 text-sm rounded-box"><%= existingLog %></pre>
      </div>
    </div>

    <script>window.FORGE_DEPLOYMENT_ID = <%= deployment.id %>;
      window.FORGE_DEPLOYMENT_STARTED_AT = <% - JSON.stringify(deployment.started_at_raw) %>;</script>
    <script src="/public/js/deployment.js"></script>
    <script src="/public/js/component-search.js"></script>
    <%- include('../partials/footer') %>