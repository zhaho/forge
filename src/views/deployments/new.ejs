<%- include('../partials/header') %>
  <nav>
    <ul>
      <li><%- include('../partials/brand') %></li>
    </ul>
    <ul>
      <li><a href="/roles">Roles</a></li>
      <li><a href="/">&larr; Dashboard</a></li>
    </ul>
  </nav>
  <h1>New deployment</h1>
  <% if (error) { %>
    <p style="color: var(--pico-del-color);">
      <%= error %>
    </p>
    <% } %>
      <form method="POST" action="/deployments" autocomplete="off">
        <label for="servername">Servername
          <input type="text" id="servername" name="servername" value="<%= form.name %>" pattern="[a-z][a-z0-9-]{0,11}"
            maxlength="12" placeholder="e.g. lab" required autofocus autocomplete="off" autocapitalize="off"
            autocorrect="off" spellcheck="false" data-lpignore="true" data-1p-ignore data-bwignore
            data-form-type="other">
        </label>
        <small>Nodes will be named <code>&lt;name&gt;01</code>, <code>&lt;name&gt;02</code>, ...</small>

        <label for="role">Role
          <select id="role" name="role" required>
            <option value="" disabled <%=form.roleKey ? '' : 'selected' %>>Choose a role</option>
            <% roles.forEach(function (role) { %>
              <option value="<%= role.key %>" <%=form.roleKey===role.key ? 'selected' : '' %>><%= role.label %>
              </option>
              <% }) %>
          </select>
        </label>

        <label for="quantity">Quantity
          <input type="number" id="quantity" name="quantity" value="<%= form.quantity %>" min="1" max="10" required>
        </label>

        <button type="submit">Deploy</button>
      </form>
      <%- include('../partials/footer') %>